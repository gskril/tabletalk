# Set hosted values with Sites environment variables. Never commit real values.
FLYNET_ENVIRONMENT=staging
FLYNET_API_KEY=
FLYNET_CLIENT_ID=
FLYNET_CLIENT_SECRET=
FLYNET_AUDIENCE=
FLYNET_REDIRECT_URI=
# At least 32 random characters, required for AES-GCM encryption of provider tokens.
TOKEN_ENCRYPTION_KEY=
